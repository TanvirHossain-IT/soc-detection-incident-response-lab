// Phase 4: DNS queries and responsible processes, Sysmon Event ID 22.
Event
| where TimeGenerated > ago(24h)
| where EventLog == "Microsoft-Windows-Sysmon/Operational"
| where EventID == 22
| extend Domain = extract(@"QueryName:\s*(\S+)", 1, RenderedDescription)
| extend ProcessImage = extract(@"(?i)Image:\s*(.*?\.exe)\b", 1, RenderedDescription)
| where isnotempty(Domain) and isnotempty(ProcessImage)
| summarize QueryCount=count(), LastSeen=max(TimeGenerated) by Domain, ProcessImage
| order by QueryCount desc
